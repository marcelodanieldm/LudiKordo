# Copia este archivo como .env (no se sube a GitHub) y completa solo lo que uses.
# Los secretos de CI van en GitHub → Settings → Secrets: EXPO_TOKEN,
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON y CLAUDE_CODE_OAUTH_TOKEN (o ANTHROPIC_API_KEY).

# MCP opcionales (npm run mcp:optional -- add <nombre>)
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Solo desarrollo: abrir todo el contenido Premium sin RevenueCat (no afecta release).
EXPO_PUBLIC_DEV_PREMIUM=
