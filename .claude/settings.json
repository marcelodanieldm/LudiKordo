{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run check:i18n:*)",
      "Bash(npm run check:agents:*)",
      "Bash(npm run sync:skills:*)",
      "Bash(npx tsx --test:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git describe:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo prebuild:*)",
      "Edit(./.github/**)",
      "Edit(./eas.json)",
      "Edit(./app.json)",
      "Edit(./src/billing/**)",
      "Edit(./modules/pitch-detector/android/src/main/AndroidManifest.xml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./google-play-key.json)",
      "Read(./**/*service-account*.json)",
      "Bash(eas submit:*)",
      "Bash(npx eas-cli submit:*)",
      "Bash(eas build:*)",
      "Bash(npx eas-cli build:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(git tag:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/post-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
